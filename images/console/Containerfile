# Build the console binary. Build from the repo root:
#   docker build -f images/console/Containerfile .
#
# Precise semver tags only (no digests, no rolling tags); Dependabot opens a PR per version.
# distroless/static publishes no semver tag, so :nonroot is the one rolling exception.
#
# Cross-compile on the build host instead of emulating the target (see Dockerfile).
FROM --platform=${BUILDPLATFORM} docker.io/library/golang:1.27.3 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

# .dockerignore filters this down to Go sources and the embedded static assets.
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o console ./cmd/console

FROM gcr.io/distroless/static-debian13:nonroot
WORKDIR /
COPY --from=builder /workspace/console .
USER 65532:65532

ENTRYPOINT ["/console"]
