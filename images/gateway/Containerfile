# The crew gateway image: upstream's own image plus the runtimes an agent needs.
#
# Upstream ships a deliberately minimal image — ca-certificates, curl, git,
# ripgrep, tini, unzip, kiro-cli and the KiroCrew wheel, on python:3.12. That is
# enough to run the gateway but not enough to run the MCP ecosystem, which is
# distributed almost entirely as `uvx` (Python) and `npx` (Node) commands. On the
# stock image a crew's MCP servers simply fail to start, which makes the
# operator's own spec.mcpConfigRef field close to decorative.
#
# So this image adds uv/uvx, node/npm/npx, and tailscale + tailscaled (Tailscale
# SSH runs inside this container), each copied from its own official image
# rather than fetched at build time.
#
# Precise semver tags only (no digests, no rolling tags); Dependabot opens a PR per version.
#
# EVERY addition is verified at the end of the build. These paths come from other
# projects' layouts, and a layout change would otherwise ship a subtly broken
# image; failing the build is the cheaper outcome.

# uv publishes its binaries at the image root (its own ENTRYPOINT is /uv).
FROM ghcr.io/astral-sh/uv:0.13.0 AS uv

# Tailscale's image is Alpine-based while ours is Debian, which is fine because
# these are static Go binaries — the version check at the end of the build is
# what actually proves it rather than assuming.
FROM ghcr.io/tailscale/tailscale:v1.104.1 AS tailscale

# trixie-slim matches the base image's own Debian release, so the runtime's
# glibc is the one node was built against.
FROM docker.io/library/node:26.11.1-trixie-slim AS node

FROM ghcr.io/kirodotdev/kirocrew:0.8.0

# Upstream ends on USER kirocrew; installing needs root, and the final USER
# below hands it back. WORKDIR is inherited untouched.
USER root

# uv and uvx — the runtime for uvx-distributed MCP servers.
COPY --from=uv /uv /uvx /usr/local/bin/

# node and npm — npx-distributed MCP servers, and any JS/TS work a crew does.
# npm is a JS tree rather than a binary, so its whole node_modules comes along
# and the bin entries are re-linked below.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

# tailscale and tailscaled. The entrypoint below runs the daemon as the gateway's
# own non-root user in userspace mode with Tailscale SSH enabled, so the SSH
# shell lands where `kirocrew` and the data volume are. /usr/local/bin/tailscale
# is also where the product looks for the CLI (a fixed allowlist, never PATH).
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscaled /usr/local/bin/

# Supervises tailscaled next to the gateway and exits if either dies.
COPY --chmod=755 images/gateway/kirocrew-tailscale-entrypoint /usr/local/bin/kirocrew-tailscale-entrypoint

RUN set -eux; \
    # node is copied as a bare binary, but it is dynamically linked against more
    # than libc: from node 26 on it needs libatomic, which the Python base does
    # not ship. Installing it from the base's own apt repo keeps the ABI matched
    # to this image's glibc and is arch-correct on both amd64 and arm64, which
    # copying the .so out of the node stage would not be.
    apt-get update; \
    apt-get install -y --no-install-recommends libatomic1 locales; \
    rm -rf /var/lib/apt/lists/*; \
    # ssh clients forward LC_* (macOS sends en_US.UTF-8); without the locale bash
    # warns on every login. Generate a few, not locales-all; LANG stays C.UTF-8.
    sed -i -E 's/^# *(en_US|en_GB|en_ZA)\.UTF-8 UTF-8/\1.UTF-8 UTF-8/' /etc/locale.gen; \
    locale-gen; \
    ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
    # Fail the build now rather than ship an image whose tools are missing or
    # cannot execute on this libc. This is what caught the missing libatomic.
    uv --version; \
    uvx --version; \
    node --version; \
    npm --version; \
    npx --version; \
    tailscale version --daemon=false; \
    tailscaled --version; \
    locale -a | grep -qix 'en_US.utf8'; \
    locale -a | grep -qix 'en_GB.utf8'; \
    locale -a | grep -qix 'en_ZA.utf8'; \
    # The agent runtime and the gateway must still be intact.
    command -v kiro-cli; \
    command -v kirocrew; \
    # The desktop app runs `ssh <host> 'exec kirocrew token'` and looks for
    # kirocrew under ~/.local/bin. Tailscale SSH sessions do not inherit the
    # container environment, so the wrapper and the shell startup files source
    # the file the entrypoint writes (KIROCREW_HOME and friends) first.
    KIROCREW_BIN="$(command -v kirocrew)"; \
    # install -d only chowns the last component, so name every parent explicitly.
    install -d -o kirocrew -g kirocrew /home/kirocrew/.local /home/kirocrew/.local/bin /home/kirocrew/.local/share; \
    # kiro-cli keeps its auth DB here; the entrypoint creates the target on the data volume.
    ln -s /data/kiro-cli /home/kirocrew/.local/share/kiro-cli; \
    chown -h kirocrew:kirocrew /home/kirocrew/.local/share/kiro-cli; \
    printf '%s\n' \
        '#!/bin/sh' \
        '[ -f "$HOME/.kirocrew-env" ] && . "$HOME/.kirocrew-env"' \
        "exec ${KIROCREW_BIN} \"\$@\"" \
        > /tmp/kirocrew-wrapper; \
    install -o kirocrew -g kirocrew -m 755 /tmp/kirocrew-wrapper /home/kirocrew/.local/bin/kirocrew; \
    rm /tmp/kirocrew-wrapper; \
    for rc in .bashrc .profile; do \
        { printf '%s\n' '[ -f "$HOME/.kirocrew-env" ] && . "$HOME/.kirocrew-env"'; cat "/home/kirocrew/$rc"; } > "/tmp/$rc"; \
        install -o kirocrew -g kirocrew -m 644 "/tmp/$rc" "/home/kirocrew/$rc"; \
        rm "/tmp/$rc"; \
    done; \
    # The wrapper must resolve to the real binary, not itself.
    test "${KIROCREW_BIN}" != /home/kirocrew/.local/bin/kirocrew; \
    /home/kirocrew/.local/bin/kirocrew --help >/dev/null

USER kirocrew

# tini reaps whatever Tailscale SSH sessions leave behind; the script is its child.
ENTRYPOINT ["tini", "--", "kirocrew-tailscale-entrypoint"]
CMD ["gateway"]

LABEL org.opencontainers.image.title="kiro-crew-gateway" \
      org.opencontainers.image.description="KiroCrew gateway with uv, Node and Tailscale SSH, for the kiro-crew-operator" \
      org.opencontainers.image.source="https://github.com/lsdopen/kiro-crew-operator" \
      org.opencontainers.image.base.name="ghcr.io/kirodotdev/kirocrew"
