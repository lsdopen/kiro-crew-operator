package web

import "strings"

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'/>
			<title>Kiro Crew console</title>
			<link rel="stylesheet" href="/static/console.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body hx-headers={ templ.JSONString(map[string]string{"X-CSRF-Token": p.CSRF}) }>
			<header>
				<strong>Kiro Crew</strong>
				<nav>
					@navLink("/crews", "Crews")
					@navLink("/requests", "Requests")
					if p.Role == "admin" {
						@navLink("/accounts", "Accounts")
						@navLink("/config", "Config")
					}
				</nav>
				<span class="muted">{ p.Email } ({ p.Role })</span>
				<form method="post" action="/auth/logout">
					<input type="hidden" name="csrf_token" value={ p.CSRF }/>
					<button type="submit">Sign out</button>
				</form>
			</header>
			<main id="content">
				@Content(p)
			</main>
		</body>
	</html>
}

templ navLink(href, label string) {
	<a href={ templ.SafeURL(href) } hx-get={ href } hx-target="#content" hx-push-url="true">{ label }</a>
}

templ Content(p Page) {
	switch p.Active {
		case "requests":
			@Requests(p)
		case "accounts":
			@Accounts(p)
		case "config":
			@Config(p)
		default:
			@Crews(p)
	}
}

templ Crews(p Page) {
	<h2>Crews</h2>
	<div id="flash" role="status">
		if p.Notice != "" {
			<p>{ p.Notice }</p>
		}
	</div>
	if len(p.Crews) == 0 {
		<p class="muted">No crews yet.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>Name</th>
					if p.ShowOwner {
						<th>Owner</th>
					}
					<th>Phase</th>
					<th>Schedule</th>
					<th>Dashboard</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, c := range p.Crews {
					<tr>
						<td>{ c.Name }</td>
						if p.ShowOwner {
							<td>{ c.Owner }</td>
						}
						<td>{ c.Phase }</td>
						<td>{ c.Schedule }</td>
						<td>
							if c.DashboardURL != "" {
								<span>{ c.DashboardURL }</span>
								if p.CanOpen {
									<form class="inline" method="post" action={ templ.SafeURL("/crews/" + c.Name + "/open") }>
										<input type="hidden" name="csrf_token" value={ p.CSRF }/>
										<button type="submit">Open</button>
									</form>
								}
								<div class="muted">Requires Tailscale, connected as { p.Email }</div>
							} else if c.LoginURL != "" {
								<a href={ templ.URL(c.LoginURL) } rel="noopener noreferrer">Authenticate your crew node</a>
							}
						</td>
						<td>
							if c.CanControl {
								<form class="inline" method="post" action={ templ.SafeURL("/crews/" + c.Name + "/start") } hx-post={ "/crews/" + c.Name + "/start" } hx-target="#content">
									<input type="hidden" name="csrf_token" value={ p.CSRF }/>
									<button type="submit">Start</button>
								</form>
								<form class="inline" method="post" action={ templ.SafeURL("/crews/" + c.Name + "/stop") } hx-post={ "/crews/" + c.Name + "/stop" } hx-target="#content">
									<input type="hidden" name="csrf_token" value={ p.CSRF }/>
									<button type="submit">Stop</button>
								</form>
							}
						</td>
					</tr>
					if c.CanControl {
						<tr>
							<td colspan={ crewCols(p) }>
								<details>
									<summary>Edit { c.Name }</summary>
									@crewEdit(p, c)
								</details>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	}
}

templ crewEdit(p Page, c CrewRow) {
	<form class="stack" method="post" action={ templ.SafeURL("/crews/" + c.Name + "/schedule") } hx-post={ "/crews/" + c.Name + "/schedule" } hx-target="#content">
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<fieldset>
			<legend>Schedule (blank up and down to run always). Saving can start or stop the crew at once.</legend>
			<label>Up <input name="up" value={ c.Up } placeholder="0 8 * * 1-5" maxlength="64"/></label>
			<label>Down <input name="down" value={ c.Down } placeholder="0 18 * * 1-5" maxlength="64"/></label>
			<label>Timezone <input name="timezone" value={ c.Zone } placeholder="UTC" maxlength="64"/></label>
		</fieldset>
		<button type="submit">Save schedule</button>
	</form>
	if c.Pinned {
		<p class="muted">Resources pinned by an admin.</p>
	} else {
		<form class="stack" method="post" action={ templ.SafeURL("/crews/" + c.Name + "/resize") } hx-post={ "/crews/" + c.Name + "/resize" } hx-target="#content">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<label>Size (now { c.Size })
				<select name="size">
					for _, s := range p.Sizes {
						<option value={ s } selected?={ s == c.Size }>{ s }</option>
					}
				</select>
			</label>
			<label>Reason (optional) <input name="reason" maxlength="500"/></label>
			<p class="muted">A resize needs approval. Once approved it applies at once and restarts the crew. Disk only grows.</p>
			<button type="submit">Request resize</button>
		</form>
	}
	if p.Role == "admin" {
		<form class="stack" method="post" action={ templ.SafeURL("/crews/" + c.Name + "/mcp") } hx-post={ "/crews/" + c.Name + "/mcp" } hx-target="#content">
			<input type="hidden" name="csrf_token" value={ p.CSRF }/>
			<label>MCP config
				<select name="mcp_config_ref">
					<option value="" selected?={ c.MCPConfigRef == "" }>(default)</option>
					for _, m := range p.MCPConfigs {
						<option value={ m } selected?={ m == c.MCPConfigRef }>{ m }</option>
					}
				</select>
			</label>
			<button type="submit">Save MCP config</button>
		</form>
	}
}

templ Flash(msg string) {
	<p class="error" role="alert">{ msg }</p>
}

templ Requests(p Page) {
	<h2>Requests</h2>
	<div id="flash" role="status">
		if p.Notice != "" {
			<p>{ p.Notice }</p>
		}
	</div>
	@requestForm(p)
	if len(p.Requests) == 0 {
		<p class="muted">No requests.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>Name</th>
					if p.ShowOwner {
						<th>Requester</th>
					}
					<th>Size</th>
					<th>Phase</th>
					<th>Decided by</th>
					<th>Crew</th>
					<th>Reason</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, q := range p.Requests {
					<tr>
						<td>{ q.Name }</td>
						if p.ShowOwner {
							<td>{ q.Requester }</td>
						}
						<td>{ q.Size }</td>
						<td>{ q.Phase }</td>
						<td>{ q.DecidedBy }</td>
						<td>{ q.CrewRef }</td>
						<td>{ q.Reason }</td>
						<td>
							if q.CanDecide {
								<form class="inline" method="post" action={ templ.SafeURL("/requests/" + q.Name + "/decision") } hx-post={ "/requests/" + q.Name + "/decision" } hx-target="#content">
									<input type="hidden" name="csrf_token" value={ p.CSRF }/>
									<button type="submit" name="verdict" value="approved">Approve</button>
									<button type="submit" name="verdict" value="denied">Deny</button>
								</form>
							}
							if q.CanCancel {
								<form class="inline" method="post" action={ templ.SafeURL("/requests/" + q.Name + "/cancel") } hx-post={ "/requests/" + q.Name + "/cancel" } hx-target="#content">
									<input type="hidden" name="csrf_token" value={ p.CSRF }/>
									<button type="submit">Cancel</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ requestForm(p Page) {
	<h3>Request a crew</h3>
	if p.NoManager {
		<p class="muted">No manager set: an admin must approve your request.</p>
	}
	<form class="stack" method="post" action="/requests" hx-post="/requests" hx-target="#content">
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<label>Size
			<select name="size">
				for _, s := range p.Sizes {
					<option value={ s } selected?={ s == p.DefaultSize }>{ s }</option>
				}
			</select>
		</label>
		<fieldset>
			<legend>Schedule (optional, leave blank to run always)</legend>
			<label>Up <input name="up" placeholder="0 8 * * 1-5" maxlength="64"/></label>
			<label>Down <input name="down" placeholder="0 18 * * 1-5" maxlength="64"/></label>
			<label>Timezone <input name="timezone" placeholder="UTC" maxlength="64"/></label>
		</fieldset>
		<label>Reason (optional) <input name="reason" maxlength="500"/></label>
		<button type="submit">Request</button>
	</form>
}

templ Accounts(p Page) {
	<h2>Accounts</h2>
	<div id="flash" role="status">
		if p.Notice != "" {
			<p>{ p.Notice }</p>
		}
	</div>
	<table>
		<thead>
			<tr>
				<th>Email</th>
				<th>Name</th>
				<th>Role</th>
				<th>Manager</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			for _, a := range p.Accounts {
				<tr>
					<td>{ a.Email }</td>
					<td>{ a.DisplayName }</td>
					<td>
						<select name="role" form={ "acct-" + a.Name } aria-label={ "Role of " + a.Email }>
							for _, r := range []string{"user", "manager", "admin"} {
								<option value={ r } selected?={ r == a.Role }>{ r }</option>
							}
						</select>
					</td>
					<td><input name="manager" form={ "acct-" + a.Name } value={ a.Manager } maxlength="254" aria-label={ "Manager of " + a.Email }/></td>
					<td>
						<form id={ "acct-" + a.Name } class="inline" method="post" action={ templ.SafeURL("/accounts/" + a.Name) } hx-post={ "/accounts/" + a.Name } hx-target="#content">
							<input type="hidden" name="csrf_token" value={ p.CSRF }/>
							<button type="submit">Save</button>
						</form>
						<form class="inline" method="post" action={ templ.SafeURL("/accounts/" + a.Name + "/delete") } hx-post={ "/accounts/" + a.Name + "/delete" } hx-target="#content" hx-confirm={ "Delete " + a.Email + "?" }>
							<input type="hidden" name="csrf_token" value={ p.CSRF }/>
							<button type="submit">Delete</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ Config(p Page) {
	<h2>Config</h2>
	<div id="flash" role="status">
		if p.Notice != "" {
			<p>{ p.Notice }</p>
		}
	</div>
	<form class="stack" method="post" action="/config" hx-post="/config" hx-target="#content">
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		<fieldset>
			<legend>Allowed sizes</legend>
			for _, c := range p.Config.Allowed {
				<label><input type="checkbox" name="allowed" value={ c.Name } checked?={ c.Allowed }/> { c.Name }</label>
			}
		</fieldset>
		<label>Default size
			<select name="default_size">
				for _, c := range p.Config.Allowed {
					<option value={ c.Name } selected?={ c.Name == p.Config.DefaultSize }>{ c.Name }</option>
				}
			</select>
		</label>
		<label>Gateway image (blank for the built-in) <input name="gateway_image" value={ p.Config.GatewayImage } maxlength="512"/></label>
		<label>Tailscale image (blank for the built-in) <input name="tailscale_image" value={ p.Config.TailscaleImage } maxlength="512"/></label>
		<label>MCP config ConfigMap (blank for none) <input name="mcp_config_ref" value={ p.Config.MCPConfigRef } maxlength="253"/></label>
		<label>MCP configs admins may pick for a crew (one ConfigMap name per line) <textarea name="mcp_configs" rows="4" maxlength="4096">{ strings.Join(p.Config.MCPConfigs, "\n") }</textarea></label>
		<button type="submit">Save</button>
	</form>
}
